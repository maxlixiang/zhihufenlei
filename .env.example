# 不要在此文件填写真实密钥；复制为 .env 后再填写。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=3

# 原始文章库必须是只读数据源，可在本机覆盖 taxonomy.yaml 中的路径。
SOURCE_LIBRARY=
DATABASE_PATH=data/classification.db
EXPORT_PATH=exports/classifications.jsonl
